@model IEnumerable<HangHoa>
@if (!Model.Any())
{
  <p>Không có hàng hóa phù hợp trong danh mục này.</p>
}
else
{
  <div class="section group">
  @foreach (var item in Model)
  {
    <div class="grid_1_of_4 images_1_of_4 product-card">
      <img src="@(string.IsNullOrWhiteSpace(item.Anh) ? Url.Content("~/images/preview.jpg") 
            : (item.Anh.StartsWith("http") ? item.Anh 
            : Url.Content(item.Anh.StartsWith("uploads/") ? "~/" + item.Anh 
            : "~/images/" + item.Anh)))" alt="@item.TenHang" />
      <h2>@item.TenHang</h2>
      <p><small>@item.LoaiHang?.TenLoai</small></p>
      <div class="price-details"><div class="price-number"><p><span class="rupees">@item.Gia?.ToString("N0")</span></p></div><div class="clear"></div></div>
    </div>
  }
  </div>
}
