@using Microsoft.EntityFrameworkCore
@using SinhVien_MaSV.Data
@inject QLHangHoaContext Db
@inject IConfiguration Configuration
@{
    ViewBag.StudentName = Configuration["Student:Name"] ?? "Họ Tên Sinh Viên";
    ViewBag.LoaiHang = await Db.LoaiHang.OrderBy(x => x.MaLoai).ToListAsync();
}
<!DOCTYPE HTML>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewBag.StudentName ?? "Cửa hàng trực tuyến") - Online Store</title>
    <link href="~/css/style.css" rel="stylesheet" />
    <link href="~/css/global.css" rel="stylesheet" />
    <link href="~/css/slider.css" rel="stylesheet" />
    <style>
      .exam-actions{display:flex;gap:14px;align-items:center;justify-content:flex-end;padding:12px 0}
      .exam-actions a,.add-link{background:#e44f2b;color:#fff!important;padding:9px 14px;border-radius:3px;text-decoration:none}
      .product-card img{max-width:100%;height:155px;object-fit:contain}
      .product-card h2{min-height:42px}.validation-summary-errors,.field-validation-error{color:#c62828}
      .form-panel{background:#fff;padding:22px;margin:20px 0;border:1px solid #ddd}
      .form-row{margin:12px 0}.form-row label{display:block;font-weight:bold;margin-bottom:5px}
      .form-row input,.form-row select{padding:9px;width:min(100%,420px);border:1px solid #ccc}
      .btn-submit{background:#e44f2b;color:white;border:0;padding:11px 20px;cursor:pointer}
      #product-area{min-height:200px}.ajax-loading{padding:20px;color:#777}
      .notice{background:#e7f6e7;color:#216b21;padding:10px;margin:10px 0}
    </style>
</head>
<body>
<div class="wrap">
    @await Html.PartialAsync("_Header")
    <div class="exam-actions">
        <a asp-controller="HangHoa" asp-action="Create">+ Thêm hàng hóa</a>
    </div>
    <main class="main"><div class="content">@RenderBody()</div></main>
</div>
@await Html.PartialAsync("_Footer")
<script src="~/js/jquery-1.7.2.min.js"></script>
<script>
$(function () {
  $(document).on('click', '.category-filter', function (e) {
    e.preventDefault();
    var link = $(this), id = link.data('id');
    $('.category-filter').parent().removeClass('active');
    link.parent().addClass('active');
    $('#product-area').html('<p class="ajax-loading">Đang tải dữ liệu...</p>');
    $.get('@Url.Action("ByCategory", "Home")', { id: id })
      .done(function (html) { $('#product-area').html(html); })
      .fail(function () { $('#product-area').html('<p>Không thể tải danh sách hàng hóa.</p>'); });
  });
});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
